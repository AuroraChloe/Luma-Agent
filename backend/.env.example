# LLM provider. Default target is any OpenAI-compatible /v1 endpoint.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=replace-with-your-provider-key
DEFAULT_MODEL=moonshotai/kimi-k2.6
AGENT_MODEL=moonshotai/kimi-k2.6

# Alibaba Cloud Model Studio real-time ASR.
# This is a DashScope API key, not the ALIYUN_ACCESS_KEY_* used by SMS.
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_ASR_MODEL=fun-asr-realtime
DASHSCOPE_ASR_SAMPLE_RATE=16000

# Dedicated vision route. Qwen reuses DASHSCOPE_API_KEY and receives the
# public URL of images persisted under UPLOAD_DIR.
VISION_LLM_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
VISION_LLM_MODEL=qwen3-vl-plus
VISION_LLM_TIMEOUT=75

# Provider capabilities. Turn off unsupported features instead of changing code.
LLM_SUPPORTS_TOOLS=true
LLM_SUPPORTS_VISION=true
LLM_SUPPORTS_IMAGES=false
LLM_MODELS_FROM_UPSTREAM=false
MODELS_CACHE_TTL_SECONDS=300

# Image provider is intentionally independent from the chat provider.
# openai_images works with chatgpt2api and providers implementing both
# /images/generations and multipart /images/edits.
IMAGE_PROVIDER=openai_images
IMAGE_BASE_URL=http://127.0.0.1:3000/v1
IMAGE_API_KEY=replace-with-image-provider-key
IMAGE_MODEL=gpt-image-2
IMAGE_GENERATION_TIMEOUT_SECONDS=360

# Qwen Image 3 alternative. Use IMAGE_PROVIDER=qwen_image and replace the
# workspace id. Qwen editing uses /images/generations with image input rather
# than the OpenAI multipart /images/edits endpoint.
# IMAGE_PROVIDER=qwen_image
# IMAGE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# IMAGE_API_KEY=replace-with-dashscope-api-key
# IMAGE_MODEL=qwen-image-3.0

# RAG document routing and semantic chunking use the chat provider; embeddings
# remain independently configured through RAG_EMBEDDING_*.
RAG_DOC_TYPE_MODEL=deepseek-v4-flash
RAG_SEMANTIC_CHUNK_MODEL=deepseek-v4-flash

# Single deployment API authentication. Leave blank only behind a trusted
# internal gateway. Luma has no browser Cookie, password, SMS or billing
# subsystem.
LUMA_API_KEY=replace-with-a-long-random-service-key

# Durable project state. The current storage adapter is PostgreSQL based.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=luma_agent
POSTGRES_USER=luma
POSTGRES_PASSWORD=replace-with-a-strong-password

# Redis is runtime coordination only. PostgreSQL remains the durable source of
# truth for messages, final job state, usage, RAG documents and vectors.
# Docker Compose service hostname. For a non-containerized local process, use
# redis://127.0.0.1:6379/0 instead.
REDIS_URL=redis://redis:6379/0
REDIS_JOB_STREAM=luma:jobs
REDIS_JOB_GROUP=luma-workers
REDIS_JOB_WORKER_CONCURRENCY=8
REDIS_JOB_STATE_TTL_SECONDS=3600
REDIS_SESSION_ACTIVE_TTL_SECONDS=21600
REDIS_JOB_CANCEL_TTL_SECONDS=3600
REDIS_JOB_CLAIM_IDLE_MS=30000
REDIS_JOB_HEARTBEAT_SECONDS=10
REDIS_JOB_EVENT_HEARTBEAT_SECONDS=15
REDIS_JOB_STREAM_MAXLEN=10000

# Media is always local in this distribution. Mount this directory as durable
# storage and serve it through your reverse proxy at PUBLIC_MEDIA_BASE_URL.
UPLOAD_DIR=./data/media
PUBLIC_API_BASE=http://localhost:8001
PUBLIC_IMAGE_BASE_URL=http://localhost:8001
PUBLIC_MEDIA_BASE_URL=http://localhost:8001/temp_file
MEDIA_LOCAL_RETENTION_SECONDS=0

# Runtime limits.
OPENAI_REQUEST_TIMEOUT=75
AGENT_TIMEOUT=75
CHAT_GLOBAL_CONCURRENCY=32
CHAT_USER_CONCURRENCY=4
CHAT_MODEL_CONCURRENCY=12
IMAGE_CONCURRENCY=2

# Read-only Coding Agent workspace limits.
CODING_WORKSPACE_ROOT=./data/coding_workspaces
CODING_MAX_FILES=1600
CODING_MAX_FILE_BYTES=2097152
CODING_MAX_TOTAL_BYTES=83886080
CODING_ANALYSIS_MAX_ITERATIONS=12
VIDEO_KEYFRAME_SIZE=1536x1024

# Storyboard-to-video gateway. Completed clips are cached in UPLOAD_DIR before
# the local reverse proxy exposes them.
VIDEO_GATEWAY_BASE_URL=https://comfy.example.com/video-api
VIDEO_GATEWAY_API_KEY=replace-with-video-gateway-key
VIDEO_RESOLUTION=480p
VIDEO_ASPECT_RATIO=16:9
VIDEO_INSTANCE_TYPE=ultra
VIDEO_POLL_INTERVAL_SECONDS=4
VIDEO_POLL_TIMEOUT_SECONDS=900
VIDEO_DOWNLOAD_MAX_BYTES=1073741824
